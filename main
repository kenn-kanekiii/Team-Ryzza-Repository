// CODE BY: JANN ALDRED NOVIO (Member 2)
// Alerts and warnings: Alert, AlertScreen (checkSeverity, triggerAlert, checkSeasonalAlerts, checkWeatherWarnings)
// ===================================================================
class Alert {
    private int entryId;
    private String level;      
    private String message;
    private String date;

    public Alert(int entryId, String level, String message, String date) {
        this.entryId = entryId;
        this.level = level;
        this.message = message;
        this.date = date;
    }

    public int getEntryId() { return entryId; }
    public String getLevel() { return level; }
    public String getMessage() { return message; }
    public String getDate() { return date; }
}

class AlertScreen {
    private ArrayList<Alert> alertHistory = new ArrayList<Alert>();

    public boolean checkSeverity(Entry entry) {
        if (entry == null) {
            return false;
        }
        return entry.isHighSeverity();
    }

    public Alert triggerAlert(Entry entry) {
        if (!checkSeverity(entry)) {
            return null;
        }

        String message = entry.getType().toUpperCase() + " at " + entry.getLocation()
                + ": " + entry.getSummary();
        Alert alert = new Alert(entry.getId(), "hIGH", message, entry.getDate());
        alertHistory.add(alert);

        System.out.println();
        System.out.println("============================================================");
        System.out.println("  [HIGH SEVERITY ALERT] Entry #" + entry.getId());
        System.out.println("  " + message);
        System.out.println("============================================================");
        return alert;
    }

    public ArrayList<String> checkSeasonalAlerts(String location, String date) {
        ArrayList<String> alerts = new ArrayList<String>();
            // TODO: hardcoded seasonal rules
        return alerts;
    }

    public static final double HEAT_WAVE_TEMP = 10; //31 dapat , for demonstration lang
    public static final double ROUGH_SEA_WAVE = 2.5;   // wave height in m, this or higher (adjustable)


    private WeatherService weather = new WeatherService();   

    public ArrayList<String> checkWeatherWarnings(double latitude, double longitude) {
        ArrayList<String> warnings = new ArrayList<String>();

        double seaTemp = weather.getSeaTemperature(latitude, longitude);
        double waveHeight = weather.getWaveHeight(latitude, longitude);

        if (Double.isNaN(seaTemp) && Double.isNaN(waveHeight)) {
            warnings.add("Weather data unavailable (no connection, or no ocean data here).");
            return warnings;
        }
        if (!Double.isNaN(waveHeight) && waveHeight >= ROUGH_SEA_WAVE) {
            warnings.add(String.format("Rough seas: wave height %.1f m", waveHeight));
        }

        if (seaTemp >= HEAT_WAVE_TEMP) {
            warnings.add(String.format("Heat wave: sea surface temperature %.1f C", seaTemp));
        }

            if (warnings.isEmpty()) {
                System.out.println("No weather warnings.");
            }

            for (String w : warnings) {
                System.out.println("[WARNING] " + w);
            }

        return warnings;
    }
     public void showWeatherWarnings(double latitude, double longitude) {
    ArrayList<String> warnings = checkWeatherWarnings(latitude, longitude);

    if (warnings.isEmpty()) {
        System.out.println("No weather warnings.");
    }
    for (String w : warnings) {
        System.out.println("[WARNING] " + w);
    }
    }
    

}

// ===================================================================
// CODE BY: JANN ALDRED NOVIO (Member 2)
// WeatherService: gets sea temperature and wave height from Open-Meteo (used by AlertScreen)
// ===================================================================
class WeatherService {
    // Sends the request and returns the reply text, or null if it failed
    private String fetch(String url) {
        try {
            HttpClient client = HttpClient.newBuilder()
                    .connectTimeout(Duration.ofSeconds(5)).build();
            HttpRequest request = HttpRequest.newBuilder()
                    .uri(URI.create(url)).timeout(Duration.ofSeconds(5)).GET().build();
            HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());
            if (response.statusCode() != 200) {
                return null;
            }
            return response.body();
        } catch (Exception ex) {
            return null;
        }
    }

    // Returns NaN for "null" or anything that is not a number
    private double toNumber(String text) {
        try {
            return Double.parseDouble(text.trim());
        } catch (NumberFormatException ex) {
            return Double.NaN;
        }
    }

    public double getSeaTemperature(double latitude, double longitude) {
        try {
        String url = "https://marine-api.open-meteo.com/v1/marine?latitude=" + latitude
                    + "&longitude=" + longitude + "&current=sea_surface_temperature&timezone=Asia%2FManila";

            HttpClient client = HttpClient.newBuilder()
                    .connectTimeout(Duration.ofSeconds(5)).build();
            HttpRequest request = HttpRequest.newBuilder()
                    .uri(URI.create(url)).timeout(Duration.ofSeconds(5)).GET().build();
            HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());

            if (response.statusCode() != 200) {
                return Double.NaN;
            }

            String body = response.body();
            int current = body.indexOf("\"current\":{");
            if (current < 0) {
                return Double.NaN;
            }
            String key = "\"sea_surface_temperature\":";
            int keyPos = body.indexOf(key, current);
            if (keyPos < 0) {
                return Double.NaN;
            }

            int start = keyPos + key.length();
            int end = start;
            while (end < body.length() && "-.0123456789".indexOf(body.charAt(end)) >= 0) {
                end++;
            }
            if (end == start) {
                return Double.NaN;
            }
            return Double.parseDouble(body.substring(start, end));
        } catch (Exception ex) {
            return Double.NaN;
        }
    }

    // Returns the current wave height in meters, or NaN if anything goes wrong
    public double getWaveHeight(double latitude, double longitude) {
        String url = "https://marine-api.open-meteo.com/v1/marine?latitude=" + latitude
                + "&longitude=" + longitude + "&current=wave_height&timezone=Asia%2FManila";

        String body = fetch(url);
        if (body == null) {
            return Double.NaN;
        }

        int current = body.indexOf("\"current\":{");
        if (current < 0) {
            return Double.NaN;
        }
        String key = "\"wave_height\":";
        int keyPos = body.indexOf(key, current);
        if (keyPos < 0) {
            return Double.NaN;
        }

        int start = keyPos + key.length();
        int end = start;
        while (end < body.length() && "-.0123456789".indexOf(body.charAt(end)) >= 0) {
            end++;
        }

        return toNumber(body.substring(start, end));
    }
}

// KYLLE MOREN - REPORTS + MAIN WINDOW

class Analysis {
    final int averageBleaching;
    final int totalSightings;
    final String mostCommonDebris;

    Analysis(int averageBleaching, int totalSightings, String mostCommonDebris) {
        this.averageBleaching = averageBleaching;
        this.totalSightings = totalSightings;
        this.mostCommonDebris = mostCommonDebris;
    }
}

class ReportService {

    public static List<Entry> filterEntries(List<Entry> entries, String date, String type, String location) {
        List<Entry> result = new ArrayList<Entry>();
        for (Entry e : entries) {
            boolean dateOk = date.equals("All") || e.getDate().equals(date);
            boolean typeOk = type.equals("All") || e.getType().equals(type);
            boolean locationOk = location.equals("All locations")
                    || e.getLocation().toLowerCase().contains(location.toLowerCase());   
            if (dateOk && typeOk && locationOk) {
                result.add(e);
            }
        }
        return result;
    }


    public static Analysis analyzeData(List<Entry> entries) {
        double bleachingTotal = 0;
        int coralCount = 0;
        int sightings = 0;
        Map<String, Double> debrisTotals = new HashMap<String, Double>();

        for (Entry e : entries) {
            if (e instanceof CoralEntry) {
                bleachingTotal += ((CoralEntry) e).getBleachingPercent();
                coralCount++;
            } else if (e instanceof SpeciesEntry) {
                sightings += ((SpeciesEntry) e).getCount();
            } else if (e instanceof DebrisEntry) {
                DebrisEntry d = (DebrisEntry) e;
                Double old = debrisTotals.get(d.getDebrisType());
                debrisTotals.put(d.getDebrisType(), (old == null ? 0 : old) + d.getConcentration());
            }
        }

        String mostCommon = "None recorded";
        double best = -1;
        for (Map.Entry<String, Double> m : debrisTotals.entrySet()) {
            if (m.getValue() > best) {
                best = m.getValue();
                mostCommon = m.getKey();
            }
        }

        int average = coralCount == 0 ? 0 : (int) Math.round(bleachingTotal / coralCount);
        return new Analysis(average, sightings, mostCommon);
    }

    public static String exportReport(List<Entry> entries, String format) throws IOException {
        String content;
        if (format.equals("JSON")) {
            content = toJson(entries);
        } else if (format.equals("CSV")) {
            content = toCsv(entries);
        } else {
            content = toTxt(entries);
        }
        Path file = Paths.get("reefbase-report." + format.toLowerCase());
        Files.write(file, content.getBytes(StandardCharsets.UTF_8));
        return file.toAbsolutePath().toString();
    }

    static double valueOf(Entry e) {
        if (e instanceof CoralEntry) return ((CoralEntry) e).getBleachingPercent();
        if (e instanceof SpeciesEntry) return ((SpeciesEntry) e).getCount();
        return ((DebrisEntry) e).getConcentration();
    }

    static String unitOf(Entry e) {
        if (e instanceof CoralEntry) return "% bleached";
        if (e instanceof SpeciesEntry) return "sighted";
        return "per 100 m2";
    }

    static String detailsOf(Entry e) {
        if (e instanceof SpeciesEntry) return ((SpeciesEntry) e).getSpeciesName();
        if (e instanceof DebrisEntry) return ((DebrisEntry) e).getDebrisType();
        return "Coral health survey";
    }

    static String num(double v) {
        return v == Math.floor(v) ? String.valueOf((long) v) : String.valueOf(v);
    }

    static String toTxt(List<Entry> list) {
        StringBuilder sb = new StringBuilder();
        for (Entry e : list) {
            sb.append(e.getDate()).append(" | ").append(e.getType()).append(" | ").append(detailsOf(e))
              .append(" | ").append(e.getLocation()).append(" | ").append(num(valueOf(e))).append(" ")
              .append(unitOf(e)).append(" | ").append(e.getSeverity()).append("\n");
        }
        return sb.toString();
    }

    static String csv(String s) { return "\"" + s.replace("\"", "\"\"") + "\""; }   // quote text cells

    static String toCsv(List<Entry> list) {
        StringBuilder sb = new StringBuilder("id,type,location,latitude,longitude,date,value,details,severity\n");
        for (Entry e : list) {
            sb.append(e.getId()).append(',').append(csv(e.getType())).append(',').append(csv(e.getLocation()))
              .append(',').append(e.getLatitude()).append(',').append(e.getLongitude())
              .append(',').append(csv(e.getDate())).append(',').append(num(valueOf(e))).append(',')
              .append(csv(detailsOf(e))).append(',').append(csv(e.getSeverity())).append('\n');
        }
        return sb.toString();
    }

    static String json(String s) { return "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\""; }

    static String toJson(List<Entry> list) {
        StringBuilder sb = new StringBuilder("[\n");
        for (int i = 0; i < list.size(); i++) {
            Entry e = list.get(i);
            sb.append("  {\"id\": ").append(e.getId())
              .append(", \"type\": ").append(json(e.getType()))
              .append(", \"location\": ").append(json(e.getLocation()))
              .append(", \"latitude\": ").append(e.getLatitude())
              .append(", \"longitude\": ").append(e.getLongitude())
              .append(", \"date\": ").append(json(e.getDate()))
              .append(", \"value\": ").append(num(valueOf(e)))
              .append(", \"details\": ").append(json(detailsOf(e)))
              .append(", \"severity\": ").append(json(e.getSeverity())).append("}");
            sb.append(i < list.size() - 1 ? ",\n" : "\n");
        }
        return sb.append("]").toString();
    }
}

// KYLLE - REPORTS SCREEN (filters, results table, summary, chart, export)
class ReportsScreen {
    private DataLogger logger;
    private String fDate = "All";
    private String fType = "All";
    private String fLocation = "All locations";

    public ReportsScreen(DataLogger logger) {
        this.logger = logger;
    }

    public void show(Scanner input) {
        boolean open = true;
        while (open) {
            System.out.println();
            System.out.println("=============== MARINE LIFE REPORT ===============");
            System.out.println("Filters -> date: " + fDate + " | type: " + fType + " | location: " + fLocation);
            System.out.println("  1. Set filters (date / type / location)");
            System.out.println("  2. Results table");
            System.out.println("  3. Summary");
            System.out.println("  4. Chart: coral bleaching over time");
            System.out.println("  5. Export (TXT / CSV / JSON)");
            System.out.println("  0. Back to main menu");
            System.out.print("Choose: ");
            String choice = input.nextLine().trim();

            List<Entry> shown = ReportService.filterEntries(logger.getAllEntries(), fDate, fType, fLocation);
            if (choice.equals("1")) {
                setFilters(input);
            } else if (choice.equals("2")) {
                printTable(shown);
            } else if (choice.equals("3")) {
                printSummary(shown);
            } else if (choice.equals("4")) {
                printChart(shown);
            } else if (choice.equals("5")) {
                exportChoice(shown, input);
            } else if (choice.equals("0")) {
                open = false;
            } else {
                System.out.println("Invalid choice. Type a number from 0 to 5.");
            }
        }
    }

    private void setFilters(Scanner input) {
        System.out.print("[1/3] DATE (YYYY-MM-DD, e.g. 2026-11-06 - or press Enter for all): ");
        String d = input.nextLine().trim();
        if (d.equals("") || d.equalsIgnoreCase("all")) {
            fDate = "All";
        } else {
            try {
                fDate = java.time.LocalDate.parse(d).toString();        
            } catch (java.time.format.DateTimeParseException ex) {
                fDate = "All";
                System.out.println("Not a valid date (use YYYY-MM-DD), using All.");
            }
        }

        System.out.print("[2/3] TYPE (1 All, 2 Coral, 3 Species, 4 Debris): ");
        String t = input.nextLine().trim();
        if (t.equals("2")) fType = "coral";
        else if (t.equals("3")) fType = "species";
        else if (t.equals("4")) fType = "debris";
        else fType = "All";

        System.out.print("[3/3] LOCATION (type a place name, e.g. Mabini - or press Enter for all): ");
        String loc = input.nextLine().trim();
        fLocation = (loc.equals("") || loc.equalsIgnoreCase("all")) ? "All locations" : loc;
        System.out.println("Filters saved. Choose 2 to see the results.");
    }

    private void printTable(List<Entry> list) {
        System.out.printf("%-4s %-8s %-20s %-11s %-30s %-8s%n", "ID", "Type", "Location", "Date", "Details", "Severity");
        System.out.println(repeat("-", 86));
        for (Entry e : list) {
            System.out.printf("%-4d %-8s %-20s %-11s %-30s %-8s%n",
                    e.getId(), e.getType(), e.getLocation(), e.getDate(), e.getSummary(), e.getSeverity());
        }
        if (list.isEmpty()) {
            System.out.println("(no matching records - check your filters)");
        }
        System.out.println(list.size() + " record(s)");
    }

    private void printSummary(List<Entry> list) {
        Analysis a = ReportService.analyzeData(list);
        System.out.println("Observations          : " + list.size());
        System.out.println("Average bleaching     : " + a.averageBleaching + "%");
        System.out.println("Total species sighted : " + a.totalSightings);
        System.out.println("Most common debris    : " + a.mostCommonDebris);
    }

    private void printChart(List<Entry> list) {
        List<CoralEntry> coral = new ArrayList<CoralEntry>();
        for (Entry e : list) {
            if (e instanceof CoralEntry) coral.add((CoralEntry) e);
        }
        if (coral.isEmpty()) {
            System.out.println("No coral data for these filters.");
            return;
        }
        Collections.sort(coral, new Comparator<CoralEntry>() {
            public int compare(CoralEntry a, CoralEntry b) { return a.getDate().compareTo(b.getDate()); }
        });
        System.out.println("Coral bleaching over time (each # = 5%)");
        for (CoralEntry c : coral) {
            double p = c.getBleachingPercent();
            System.out.printf("%s %-14s |%-20s| %s%%%s%n", c.getDate(), c.getLocation(),
                    repeat("#", (int) Math.round(p / 5)), ReportService.num(p),
                    c.isHighSeverity() ? "  <- CRITICAL" : "");
        }
    }

    private void exportChoice(List<Entry> shown, Scanner input) {
        if (shown.isEmpty()) {
            System.out.println("Nothing to export - the filters have no records.");
            return;
        }
        System.out.print("Format (1 TXT, 2 CSV, 3 JSON): ");
        String f = input.nextLine().trim();
        String format = f.equals("2") ? "CSV" : f.equals("3") ? "JSON" : "TXT";
        try {
            System.out.println(format + " report saved: " + ReportService.exportReport(shown, format));
        } catch (IOException ex) {
            System.out.println("Could not save the file: " + ex.getMessage());
        }
    }

    private static String repeat(String s, int n) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < n; i++) sb.append(s);
        return sb.toString();
    }
}

// KYLLE - MAIN WINDOW: home page + menu that joins the 3 screens
public class Main {

    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);


        DataLogger logger = new DataLogger();
        LogEntryScreen logScreen = new LogEntryScreen(logger);
        AlertScreen alerts = new AlertScreen();
        ReportsScreen reports = new ReportsScreen(logger);

        showHomePage();

        boolean running = true;
        while (running) {
            String choice = showMenu(logger, alerts, input);
            if (choice.equals("1")) {
                Entry saved = null;
                try {
                    saved = logScreen.show(input);        
                } catch (NumberFormatException ex) {
                    System.out.println("\nERROR: Latitude and longitude must be numbers (example: 13.74). Entry not saved.");
                }
                if (saved != null) {
                    alerts.triggerAlert(saved);           
                    System.out.println("\nChecking sea conditions at " + saved.getLocation() + " ...");
                    showWeather(alerts, saved.getLatitude(), saved.getLongitude());   
                }
            } else if (choice.equals("2")) {
                showAlertsScreen(logger, alerts, input);
            } else if (choice.equals("3")) {
                reports.show(input);
            } else if (choice.equals("0")) {
                System.out.println("Goodbye! Protect our reefs.");
                running = false;
            } else {
                System.out.println("Please type 1, 2, 3, or 0.");
            }
        }
    }

    static void showHomePage() {
        System.out.println();
        System.out.println("============================================================");
        System.out.println("   Marilog - Citizen Science & Biodiversity Tracker");
        System.out.println("        Observe the reef. Protect its future.");
        System.out.println("============================================================");
    }

    static String showMenu(DataLogger logger, AlertScreen alerts, Scanner input) {
        int total = 0;
        int high = 0;
        for (Entry e : logger.getAllEntries()) {
            total++;
            if (alerts.checkSeverity(e)) high++;
        }
        System.out.println();
        System.out.println("=============== MAIN MENU ===============");
        System.out.println("Entries logged: " + total + " | High-severity alerts: " + high);
        System.out.println("  1. Log entry   (record marine life)");
        System.out.println("  2. Alerts      (conditions and warnings)");
        System.out.println("  3. Reports     (analyze and export)");
        System.out.println("  0. Exit");
        System.out.print("Choose: ");
        return input.nextLine().trim();
    }
    static void showAlertsScreen(DataLogger logger, AlertScreen alerts, Scanner input) {
        boolean open = true;
        while (open) {
            System.out.println();
            System.out.println("=============== ALERTS ===============");
            System.out.println("  1. High-severity alerts");
            System.out.println("  2. Seasonal alerts (spawning, turtle nesting, fishing ban)");
            System.out.println("  3. Weather and sea conditions");
            System.out.println("  0. Back to main menu");
            String choice = input.nextLine().trim();

            if (choice.equals("1")) {
                int count = 0;
                for (Entry e : logger.getAllEntries()) {
                    if (alerts.checkSeverity(e)) {
                        count++;
                        System.out.println("[HIGH] Entry #" + e.getId() + " - " + e.getType().toUpperCase()
                                + " at " + e.getLocation() + " (" + e.getDate() + "): " + e.getSummary());
                    }
                }
                if (count == 0) System.out.println("No high-severity entries. The reef watch feed is clear.");
            } else if (choice.equals("2")) {
                System.out.print("Location (type a place, e.g. Mabini): ");
                String location = input.nextLine().trim();
                System.out.print("Date (YYYY-MM-DD, Enter = today): ");
                String date = input.nextLine().trim();
                if (date.equals("")) date = java.time.LocalDate.now().toString();
                printList(alerts.checkSeasonalAlerts(location, date), "No seasonal alerts for that place and date.");
            } else if (choice.equals("3")) {
                try {
                    System.out.print("Latitude (e.g. 13.74): ");
                    double lat = Double.parseDouble(input.nextLine().trim());
                    System.out.print("Longitude (e.g. 120.90): ");
                    double lon = Double.parseDouble(input.nextLine().trim());
                    System.out.println("Checking sea conditions ...");
                    showWeather(alerts, lat, lon);                 
                } catch (NumberFormatException ex) {
                    System.out.println("Latitude and longitude must be numbers.");
                }
            } else if (choice.equals("0")) {
                open = false;
            } else {
                System.out.println("Please type 1, 2, 3, or 0.");
            }
        }
    }

    static void showWeather(AlertScreen alerts, double lat, double lon) {
        ArrayList<String> w = alerts.checkWeatherWarnings(lat, lon);
        if (w.size() == 1 && w.get(0).startsWith("Weather data unavailable")) {
            System.out.println("[WARNING] " + w.get(0));
        }
    }

    static void printList(ArrayList<String> items, String emptyMessage) {
        if (items.isEmpty()) {
            System.out.println(emptyMessage);
        }
        for (String s : items) {
            System.out.println(" * " + s);
        }
    }
}
